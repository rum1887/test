# =============================================================================
# Runtime Trust Layer - Environment Variables Template
# Copy to .env for local development or set in deployment platform
# =============================================================================

# Graph Database Configuration
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH=runtime_trust_layer

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# Telemetry Sensor Mode ('live_ebpf' for Linux k8s/kind, 'replay_synthetic' for hosted demo)
RUNTIME_MODE=replay_synthetic
STALE_THRESHOLD_SECONDS=600

# Web Frontend Configuration (URL of the FastAPI backend)
VITE_API_BASE_URL=http://localhost:8000
