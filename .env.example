# FalkorDB settings
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=trust

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# LLM Configuration
# Modes: replay (offline/cached), live (Anthropic API), mock (scripted)
LLM_MODE=replay
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
CACHE_DIR=llm_cache

# Scenario & Evaluation
SCENARIOS_DIR=scenarios
TELEMETRY_LOG_PATH=telemetry.jsonl
PARALLEL_HYPOTHESES=false
