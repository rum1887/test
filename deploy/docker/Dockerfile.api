# =============================================================================
# Dockerfile for Runtime Trust Layer Backend API
# Multi-stage, unprivileged non-root user execution
# =============================================================================
FROM python:3.12-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# Final runtime image
FROM python:3.12-slim AS runner

WORKDIR /app

# Create unprivileged security user
RUN groupadd -g 10001 trustuser && \
    useradd -u 10001 -g trustuser -s /bin/sh trustuser

# Copy installed dependencies
COPY --from=builder /install /usr/local

# Copy application source
COPY . /app

# Fix permissions
RUN chown -R trustuser:trustuser /app

USER 10001:10001

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PORT=8000

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/ready')" || exit 1

CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
